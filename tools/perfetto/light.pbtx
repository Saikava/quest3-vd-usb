# a light trace: only the decoders' atrace marks (CCodecBufferChannel queue / onWorkDone; pfvideo.py), so that the
# trace itself hardly loads the headset (the full race.pbtx writes ~5 MB/s and holds 270 MB of buffers); repeated
# frames come from logcat's VrApi lines instead
buffers { size_kb: 16384 fill_policy: RING_BUFFER }
data_sources { config { name: "linux.ftrace" target_buffer: 0 ftrace_config {
  atrace_categories: "video"
  atrace_apps: "*"
  buffer_size_kb: 2048
  drain_period_ms: 1000 } } }
data_sources { config { name: "linux.process_stats" target_buffer: 0 process_stats_config { scan_all_processes_on_start: true } } }
write_into_file: true
file_write_period_ms: 2000
flush_period_ms: 10000
incremental_state_config { clear_period_ms: 1000 }
duration_ms: DURATION
