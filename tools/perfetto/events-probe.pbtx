buffers { size_kb: 65536 fill_policy: RING_BUFFER }
data_sources { config { name: "linux.ftrace" ftrace_config {
  ftrace_events: "sched/sched_switch"
  ftrace_events: "sched/sched_waking"
  ftrace_events: "sched/sched_blocked_reason"
  ftrace_events: "irq/irq_handler_entry"
  ftrace_events: "irq/irq_handler_exit"
  ftrace_events: "irq/softirq_entry"
  ftrace_events: "ipi/ipi_entry"
  ftrace_events: "power/cpu_idle"
  ftrace_events: "power/clock_set_rate"
  ftrace_events: "power/clock_enable"
  ftrace_events: "power/clock_disable"
  ftrace_events: "power/suspend_resume"
  ftrace_events: "power/gpu_frequency"
  ftrace_events: "power/cpu_frequency"
  ftrace_events: "clk/clk_set_rate"
  ftrace_events: "clk/clk_enable"
  ftrace_events: "devfreq/devfreq_frequency"
  ftrace_events: "interconnect/icc_set_bw"
  ftrace_events: "rpmh/rpmh_send_msg"
  ftrace_events: "thermal/thermal_temperature"
  ftrace_events: "thermal/cdev_update"
  ftrace_events: "workqueue/workqueue_execute_start"
  ftrace_events: "workqueue/workqueue_execute_end"
  ftrace_events: "regulator/regulator_set_voltage"
  ftrace_events: "scm/scm_call_start"
  ftrace_events: "kgsl/kgsl_gpubusy"
  ftrace_events: "dmabuf_heap/dma_heap_stat"
  ftrace_events: "mm_event/mm_event_record"
  ftrace_events: "vmscan/mm_vmscan_kswapd_wake"
  ftrace_events: "fastrpc/fastrpc_dma_stat"
  ftrace_events: "dcvsh/dcvsh_freq"
  ftrace_events: "msm_bus/bus_update_request"
  ftrace_events: "lowmemorykiller/lowmemory_kill"
  buffer_size_kb: 16384 drain_period_ms: 250 } } }
duration_ms: 5000
